---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { writeClient } from '../../utils/sanity-write-client';

// For demo: show the latest published schedule
const today = new Date();
const todayStr = today.toISOString().split('T')[0];

const currentSchedule = await writeClient.fetch(`
  *[_type == "schedule" && status == "published" && weekStartDate <= $today && weekEndDate >= $today][0]{
    _id, weekStartDate, weekEndDate,
    shifts[]{ _key, date, startTime, endTime, department, position, employee->{ _id, name } }
  }
`, { today: todayStr }).catch(() => null);

const employees = await writeClient.fetch(`*[_type == "employee"] | order(name asc) { _id, name, email, department }`).catch(() => []);
---

<Layout title="Employee Portal">
  <main class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Employee Portal</h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Current Schedule -->
      <div>
        <h2 class="text-xl font-semibold mb-4">Current Week Schedule</h2>
        {currentSchedule ? (
          <div class="overflow-x-auto">
            <p class="text-sm text-base-content/60 mb-2">{currentSchedule.weekStartDate} &ndash; {currentSchedule.weekEndDate}</p>
            <table class="table table-sm w-full">
              <thead>
                <tr><th>Employee</th><th>Date</th><th>Time</th><th>Dept</th></tr>
              </thead>
              <tbody>
                {(currentSchedule.shifts || []).map((shift: any) => (
                  <tr>
                    <td>{shift.employee?.name}</td>
                    <td>{shift.date}</td>
                    <td>{shift.startTime} &ndash; {shift.endTime}</td>
                    <td>{shift.department}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="alert alert-info"><span>No published schedule for the current week.</span></div>
        )}
      </div>

      <!-- PTO Request Form -->
      <div>
        <h2 class="text-xl font-semibold mb-4">Submit PTO Request</h2>
        <a href="/employee/pto-request" class="btn btn-primary mb-4">New PTO Request</a>

        <h2 class="text-xl font-semibold mb-3 mt-6">My PTO History</h2>
        <div id="pto-history" class="text-base-content/60 text-sm">
          <div class="form-control mb-3">
            <label class="label"><span class="label-text">Select Employee to view history:</span></label>
            <select id="employee-select" class="select select-bordered">
              <option value="">-- Select --</option>
              {employees.map((e: any) => (
                <option value={e._id}>{e.name}</option>
              ))}
            </select>
          </div>
          <div id="history-list"></div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const select = document.getElementById('employee-select') as HTMLSelectElement;
  const historyList = document.getElementById('history-list')!;

  const statusBadge: Record<string, string> = {
    pending: 'badge-warning',
    approved: 'badge-success',
    denied: 'badge-error',
    'clarification-requested': 'badge-info',
  };

  select.addEventListener('change', async () => {
    const employeeId = select.value;
    if (!employeeId) { historyList.innerHTML = ''; return; }

    historyList.innerHTML = '<span class="loading loading-spinner loading-sm"></span>';
    try {
      const res = await fetch(`/api/pto/list`);
      const all = await res.json();
      const mine = all.filter((r: any) => r.employee?._id === employeeId);

      if (mine.length === 0) {
        historyList.innerHTML = '<p class="text-base-content/60">No PTO requests found.</p>';
        return;
      }

      historyList.innerHTML = `<div class="overflow-x-auto"><table class="table table-sm w-full">
        <thead><tr><th>Type</th><th>Dates</th><th>Status</th></tr></thead>
        <tbody>
          ${mine.map((r: any) => `
            <tr>
              <td class="capitalize">${r.requestType?.replace('-', ' ')}</td>
              <td>${r.startDate}${r.startDate !== r.endDate ? ' – ' + r.endDate : ''}</td>
              <td><span class="badge ${statusBadge[r.status] || 'badge-ghost'}">${r.status}</span></td>
            </tr>
          `).join('')}
        </tbody>
      </table></div>`;
    } catch {
      historyList.innerHTML = '<p class="text-error">Failed to load PTO history.</p>';
    }
  });
</script>
