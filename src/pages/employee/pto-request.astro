---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { writeClient } from '../../utils/sanity-write-client';

const employees = await writeClient.fetch(`*[_type == "employee"] | order(name asc) { _id, name, department }`).catch(() => []);
---

<Layout title="Submit PTO Request">
  <main class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold">Submit PTO Request</h1>
      <a href="/employee" class="btn btn-ghost btn-sm">Back to Portal</a>
    </div>

    <div id="success-alert" class="alert alert-success mb-4 hidden">
      <span>PTO request submitted successfully! Your manager will review it soon.</span>
    </div>
    <div id="error-alert" class="alert alert-error mb-4 hidden">
      <span id="error-msg">An error occurred.</span>
    </div>

    <form id="pto-form" class="card bg-base-100 border border-base-200 shadow">
      <div class="card-body gap-4">
        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Employee</span></label>
          <select id="employee-id" name="employeeId" class="select select-bordered" required>
            <option value="">-- Select Employee --</option>
            {employees.map((e: any) => (
              <option value={e._id}>{e.name} ({e.department || 'No dept'})</option>
            ))}
          </select>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Request Type</span></label>
          <select id="request-type" name="requestType" class="select select-bordered" required>
            <option value="">-- Select Type --</option>
            <option value="vacation">Vacation</option>
            <option value="sick">Sick Day</option>
            <option value="personal">Personal Day</option>
            <option value="availability-exception">Availability Exception</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">Start Date</span></label>
            <input type="date" id="start-date" name="startDate" class="input input-bordered" required />
          </div>
          <div class="form-control">
            <label class="label"><span class="label-text font-semibold">End Date</span></label>
            <input type="date" id="end-date" name="endDate" class="input input-bordered" required />
          </div>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text font-semibold">Reason</span></label>
          <textarea id="reason" name="reason" class="textarea textarea-bordered" rows="4" placeholder="Please provide a reason for your request..."></textarea>
        </div>

        <div class="card-actions">
          <button type="submit" id="submit-btn" class="btn btn-primary">Submit Request</button>
          <a href="/employee" class="btn btn-ghost">Cancel</a>
        </div>
      </div>
    </form>
  </main>
</Layout>

<script>
  const form = document.getElementById('pto-form') as HTMLFormElement;
  const successAlert = document.getElementById('success-alert')!;
  const errorAlert = document.getElementById('error-alert')!;
  const errorMsg = document.getElementById('error-msg')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successAlert.classList.add('hidden');
    errorAlert.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const payload = {
      employeeId: (document.getElementById('employee-id') as HTMLSelectElement).value,
      requestType: (document.getElementById('request-type') as HTMLSelectElement).value,
      startDate: (document.getElementById('start-date') as HTMLInputElement).value,
      endDate: (document.getElementById('end-date') as HTMLInputElement).value,
      reason: (document.getElementById('reason') as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch('/api/pto/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        successAlert.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.textContent = data.error || 'Failed to submit request';
        errorAlert.classList.remove('hidden');
      }
    } catch {
      errorMsg.textContent = 'Network error. Please try again.';
      errorAlert.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Request';
    }
  });
</script>
