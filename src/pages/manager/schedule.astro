---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { writeClient } from '../../utils/sanity-write-client';

// Default to next week
const today = new Date();
const daysUntilNextMonday = (8 - today.getUTCDay()) % 7 || 7;
const nextMonday = new Date(today);
nextMonday.setUTCDate(today.getUTCDate() + daysUntilNextMonday);
const nextSunday = new Date(nextMonday);
nextSunday.setUTCDate(nextMonday.getUTCDate() + 6);

const defaultWeekStart = nextMonday.toISOString().split('T')[0];
const defaultWeekEnd = nextSunday.toISOString().split('T')[0];

const weekStart = Astro.url.searchParams.get('weekStart') || defaultWeekStart;
const weekEnd = Astro.url.searchParams.get('weekEnd') || defaultWeekEnd;

const schedule = await writeClient.fetch(
  `*[_type == "schedule" && weekStartDate == $weekStart] | order(generatedAt desc)[0]{
    _id, weekStartDate, weekEndDate, status, generatedAt, approvedAt,
    shifts[]{ _key, date, startTime, endTime, department, position, notes, employee->{ _id, name } }
  }`,
  { weekStart }
).catch(() => null);

const employees = await writeClient.fetch(`*[_type == "employee"] | order(name asc) { _id, name, department }`).catch(() => []);
---

<Layout title="Schedule Management">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <h1 class="text-3xl font-bold">Schedule Management</h1>
      <a href="/manager" class="btn btn-ghost btn-sm">Back to Dashboard</a>
    </div>

    <!-- Week Selector -->
    <form method="get" class="flex items-end gap-3 mb-6 flex-wrap">
      <div class="form-control">
        <label class="label"><span class="label-text">Week Start (Monday)</span></label>
        <input type="date" name="weekStart" value={weekStart} class="input input-bordered" />
      </div>
      <div class="form-control">
        <label class="label"><span class="label-text">Week End (Sunday)</span></label>
        <input type="date" name="weekEnd" value={weekEnd} class="input input-bordered" />
      </div>
      <button type="submit" class="btn btn-primary">Load Week</button>
    </form>

    <!-- PTO Pre-check -->
    <div id="pto-check-area" class="mb-6"></div>

    <!-- Generate button -->
    <div class="flex gap-3 mb-6 flex-wrap" id="action-bar">
      <button id="btn-generate" class="btn btn-primary" disabled>Generate Schedule</button>
      {schedule && schedule.status === 'draft' && (
        <button id="btn-approve" class="btn btn-success" data-id={schedule._id}>Approve Schedule</button>
      )}
      {schedule && schedule.status === 'approved' && (
        <button id="btn-publish" class="btn btn-accent" data-id={schedule._id}>Publish &amp; Share</button>
      )}
    </div>

    <!-- Warnings -->
    <div id="warnings-panel" class="mb-6 hidden">
      <h2 class="text-xl font-semibold mb-2">Warnings</h2>
      <div id="warnings-list" class="flex flex-col gap-2"></div>
    </div>

    <!-- Schedule Grid -->
    {schedule ? (
      <div id="schedule-grid">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xl font-semibold">Week of {schedule.weekStartDate}</h2>
          <span class={`badge ${schedule.status === 'published' ? 'badge-success' : schedule.status === 'approved' ? 'badge-info' : 'badge-warning'}`}>
            {schedule.status}
          </span>
        </div>
        <div class="overflow-x-auto">
          <table class="table table-bordered w-full text-sm" id="shifts-table" data-schedule-id={schedule._id}>
            <thead>
              <tr>
                <th>Employee</th>
                <th>Date</th>
                <th>Start</th>
                <th>End</th>
                <th>Department</th>
                <th>Position</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {(schedule.shifts || []).map((shift: any) => (
                <tr data-key={shift._key}>
                  <td>{shift.employee?.name || 'Unknown'}</td>
                  <td>{shift.date}</td>
                  <td class="shift-start">{shift.startTime}</td>
                  <td class="shift-end">{shift.endTime}</td>
                  <td>{shift.department}</td>
                  <td>{shift.position}</td>
                  <td>
                    <button class="btn btn-xs btn-outline btn-warning edit-shift-btn" data-key={shift._key}>Edit</button>
                    <button class="btn btn-xs btn-outline btn-error remove-shift-btn" data-key={shift._key}>Remove</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-4">
          <button id="btn-add-shift" class="btn btn-outline btn-sm" data-schedule-id={schedule._id}>+ Add Shift</button>
        </div>
      </div>
    ) : (
      <div class="alert alert-info" id="no-schedule-msg">
        <span>No schedule generated for this week yet. Run the PTO check above, then generate.</span>
      </div>
    )}
  </main>

  <!-- Edit Shift Modal -->
  <dialog id="shift-modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg" id="shift-modal-title">Edit Shift</h3>
      <input type="hidden" id="shift-key" />
      <div class="grid grid-cols-2 gap-3 py-4">
        <div class="form-control col-span-2">
          <label class="label"><span class="label-text">Employee</span></label>
          <select id="shift-employee" class="select select-bordered w-full">
            {employees.map((e: any) => (
              <option value={e._id}>{e.name} ({e.department || 'No dept'})</option>
            ))}
          </select>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Date</span></label>
          <input type="date" id="shift-date" class="input input-bordered" />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Department</span></label>
          <input type="text" id="shift-department" class="input input-bordered" />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">Start Time</span></label>
          <input type="time" id="shift-start" class="input input-bordered" />
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">End Time</span></label>
          <input type="time" id="shift-end" class="input input-bordered" />
        </div>
        <div class="form-control col-span-2">
          <label class="label"><span class="label-text">Position</span></label>
          <input type="text" id="shift-position" class="input input-bordered" />
        </div>
      </div>
      <div class="modal-action">
        <button id="shift-save" class="btn btn-primary">Save</button>
        <button id="shift-cancel" class="btn btn-ghost">Cancel</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <div id="toast" class="toast toast-top toast-end hidden">
    <div class="alert" id="toast-inner"><span id="toast-msg"></span></div>
  </div>
</Layout>

<script define:vars={{ weekStart, weekEnd, scheduleId: schedule?._id || null }}>
  // PTO Pre-check
  async function checkPTO() {
    try {
      const res = await fetch(`/api/schedule/check-pto?weekStart=${weekStart}&weekEnd=${weekEnd}`);
      const data = await res.json();
      const area = document.getElementById('pto-check-area');
      const btnGenerate = document.getElementById('btn-generate');
      if (data.hasPending) {
        area.innerHTML = `
          <div class="alert alert-warning flex items-center gap-3">
            <span>Schedule generation cannot continue until PTO requests for this period have been reviewed. (${data.pendingCount} pending)</span>
            <a href="/manager/pto-queue" class="btn btn-warning btn-sm ml-auto">Review PTO Requests</a>
          </div>`;
        btnGenerate.disabled = true;
      } else {
        area.innerHTML = `<div class="alert alert-success"><span>No pending PTO requests for this period. Schedule generation is available.</span></div>`;
        btnGenerate.disabled = false;
      }
    } catch {
      document.getElementById('pto-check-area').innerHTML = `<div class="alert alert-error"><span>Error checking PTO status.</span></div>`;
    }
  }
  checkPTO();

  // Generate Schedule
  document.getElementById('btn-generate')?.addEventListener('click', async () => {
    const btn = document.getElementById('btn-generate');
    btn.disabled = true;
    btn.textContent = 'Generating...';
    try {
      const res = await fetch('/api/schedule/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ weekStart, weekEnd }),
      });
      const data = await res.json();
      if (res.ok) {
        showToast('Schedule generated! Reloading...', 'alert-success');
        if (data.warnings?.length > 0) {
          showWarnings(data.warnings);
        }
        setTimeout(() => window.location.reload(), 1500);
      } else {
        showToast(data.error || 'Failed to generate schedule', 'alert-error');
        btn.disabled = false;
        btn.textContent = 'Generate Schedule';
      }
    } catch {
      showToast('Network error generating schedule', 'alert-error');
      btn.disabled = false;
      btn.textContent = 'Generate Schedule';
    }
  });

  // Approve Schedule
  document.getElementById('btn-approve')?.addEventListener('click', async () => {
    const id = document.getElementById('btn-approve').dataset.id;
    const res = await fetch(`/api/schedule/${id}/approve`, { method: 'POST' });
    if (res.ok) {
      showToast('Schedule approved!', 'alert-success');
      setTimeout(() => window.location.reload(), 1200);
    } else {
      showToast('Failed to approve schedule', 'alert-error');
    }
  });

  // Publish Schedule
  document.getElementById('btn-publish')?.addEventListener('click', async () => {
    const id = document.getElementById('btn-publish').dataset.id;
    const res = await fetch(`/api/schedule/${id}/publish`, { method: 'POST' });
    if (!res.ok) { showToast('Failed to publish schedule', 'alert-error'); return; }

    showToast('Schedule published!', 'alert-success');

    const shareData = {
      title: `Work Schedule - Week of ${weekStart}`,
      text: `The schedule for the week of ${weekStart} to ${weekEnd} is now published. Please log in to view your shifts.`,
      url: window.location.href,
    };

    if (navigator.share) {
      try { await navigator.share(shareData); } catch {}
    } else {
      window.print();
    }

    setTimeout(() => window.location.reload(), 1200);
  });

  // Edit/Remove shifts
  document.querySelectorAll('.edit-shift-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.key;
      const row = document.querySelector(`tr[data-key="${key}"]`);
      document.getElementById('shift-key').value = key;
      document.getElementById('shift-date').value = row.cells[1].textContent.trim();
      document.getElementById('shift-start').value = row.querySelector('.shift-start').textContent.trim();
      document.getElementById('shift-end').value = row.querySelector('.shift-end').textContent.trim();
      document.getElementById('shift-department').value = row.cells[4].textContent.trim();
      document.getElementById('shift-position').value = row.cells[5].textContent.trim();
      document.getElementById('shift-modal-title').textContent = 'Edit Shift';
      document.getElementById('shift-modal').showModal();
    });
  });

  document.querySelectorAll('.remove-shift-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Remove this shift?')) return;
      const key = btn.dataset.key;
      const tableEl = document.getElementById('shifts-table');
      const sid = tableEl.dataset.scheduleId;
      const res = await fetch(`/api/schedule/${sid}/shift`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key }),
      });
      if (res.ok) {
        document.querySelector(`tr[data-key="${key}"]`).remove();
        showToast('Shift removed', 'alert-success');
      } else {
        showToast('Failed to remove shift', 'alert-error');
      }
    });
  });

  // Save shift edit
  document.getElementById('shift-save')?.addEventListener('click', async () => {
    const key = (document.getElementById('shift-key')).value;
    const tableEl = document.getElementById('shifts-table');
    const sid = tableEl?.dataset.scheduleId || scheduleId;
    const employeeSelect = document.getElementById('shift-employee');
    const employeeId = employeeSelect.value;

    const payload = {
      key,
      date: document.getElementById('shift-date').value,
      startTime: document.getElementById('shift-start').value,
      endTime: document.getElementById('shift-end').value,
      department: document.getElementById('shift-department').value,
      position: document.getElementById('shift-position').value,
      employee: { _type: 'reference', _ref: employeeId },
    };

    const res = await fetch(`/api/schedule/${sid}/shift`, {
      method: key ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      document.getElementById('shift-modal').close();
      showToast('Shift saved!', 'alert-success');
      setTimeout(() => window.location.reload(), 1000);
    } else {
      showToast('Failed to save shift', 'alert-error');
    }
  });

  document.getElementById('shift-cancel')?.addEventListener('click', () => {
    document.getElementById('shift-modal').close();
  });

  // Add shift
  document.getElementById('btn-add-shift')?.addEventListener('click', () => {
    document.getElementById('shift-key').value = '';
    document.getElementById('shift-date').value = weekStart;
    document.getElementById('shift-start').value = '09:00';
    document.getElementById('shift-end').value = '17:00';
    document.getElementById('shift-department').value = '';
    document.getElementById('shift-position').value = '';
    document.getElementById('shift-modal-title').textContent = 'Add Shift';
    document.getElementById('shift-modal').showModal();
  });

  function showWarnings(warnings) {
    const panel = document.getElementById('warnings-panel');
    const list = document.getElementById('warnings-list');
    list.innerHTML = warnings.map(w =>
      `<div class="alert alert-warning text-sm"><span>${w.message}</span></div>`
    ).join('');
    panel.classList.remove('hidden');
  }

  function showToast(msg, cls) {
    const toast = document.getElementById('toast');
    const inner = document.getElementById('toast-inner');
    const msgEl = document.getElementById('toast-msg');
    inner.className = `alert ${cls}`;
    msgEl.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
  }
</script>

<style>
  @media print {
    .btn, nav, footer, #action-bar, #pto-check-area { display: none !important; }
  }
</style>
